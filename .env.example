# Accounts and keys for `npm run record` (scripts/off-the-record.mjs). Copy to .env,
# which git ignores, so the public repo never names the accounts. The script only
# runs locally. Leave a pair empty to skip that source.

# SteamID64 (17 digits) or the custom name in steamcommunity.com/id/<name>
STEAM_USER=
# https://steamcommunity.com/dev/apikey (treat it like a password)
STEAM_API_KEY=

# The name in trakt.tv/users/<name>
TRAKT_USER=
# Client ID of an app at https://trakt.tv/oauth/applications
TRAKT_CLIENT_ID=

# "API Read Access Token" from https://www.themoviedb.org/settings/api (film posters)
TMDB_TOKEN=
